{
  "name": "kaikeytime",
  "displayName": "KaikeyTime — Privacy-First Coding Analytics",
  "description": "Know exactly how you code. Tracks focus time, languages, streaks & AI-assisted lines — 100% on your machine. No account. No cloud. Share beautiful Strand cards on LinkedIn or X.",
  "version": "1.0.1",
  "publisher": "vignesh2027",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Other", "Visualization"],
  "keywords": [
    "coding analytics",
    "productivity",
    "time tracking",
    "privacy",
    "local",
    "wakatime alternative",
    "developer stats",
    "coding streak",
    "ai detection",
    "shareable card",
    "code stats",
    "focus time"
  ],
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#0a0a14",
    "theme": "dark"
  },
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/vignesh2027/keystrand"
  },
  "license": "MIT",
  "contributes": {
    "commands": [
      {
        "command": "kaikeytime.openDashboard",
        "title": "KaikeyTime: Open Dashboard",
        "category": "KaikeyTime"
      },
      {
        "command": "kaikeytime.generateStrand",
        "title": "KaikeyTime: Generate Strand Card",
        "category": "KaikeyTime"
      },
      {
        "command": "kaikeytime.exportData",
        "title": "KaikeyTime: Export My Data (JSON)",
        "category": "KaikeyTime"
      },
      {
        "command": "kaikeytime.resetData",
        "title": "KaikeyTime: Reset All Data",
        "category": "KaikeyTime"
      }
    ],
    "configuration": {
      "title": "KaikeyTime",
      "properties": {
        "kaikeytime.idleThresholdSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 30,
          "maximum": 600,
          "description": "Seconds of inactivity before considered idle. Lower = more precise active time."
        },
        "kaikeytime.trackLanguages": {
          "type": "boolean",
          "default": true,
          "description": "Track time and lines per programming language."
        },
        "kaikeytime.trackProjects": {
          "type": "boolean",
          "default": true,
          "description": "Track time and lines per project/workspace."
        },
        "kaikeytime.strandTheme": {
          "type": "string",
          "enum": ["dark", "neon", "ocean", "forest"],
          "enumDescriptions": [
            "Dark slate with purple accents",
            "Black with neon cyan/green glow",
            "Deep ocean blue gradient",
            "Forest green gradient"
          ],
          "default": "dark",
          "description": "Color theme for generated Strand cards."
        },
        "kaikeytime.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the live Pulse status bar item."
        },
        "kaikeytime.aiDetectionThreshold": {
          "type": "number",
          "default": 5,
          "minimum": 2,
          "maximum": 50,
          "description": "Minimum number of lines inserted at once to be classified as likely AI-assisted."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "^18.0.0",
    "typescript": "^5.1.0"
  }
}
